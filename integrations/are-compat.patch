+++ b/are/simulation/agents/llm/openai_compat_engine.py
@@ -0,0 +1,212 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+# All rights reserved.
+#
+# This source code is licensed under the terms described in the LICENSE file in
+# the root directory of this source tree.
+
+import hashlib
+import json
+import logging
+import os
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+import requests
+from pydantic import BaseModel
+
+from are.simulation.agents.llm.llm_engine import LLMEngine, LLMEngineException
+from are.simulation.agents.llm.types import MessageRole
+from are.simulation.agents.multimodal import Attachment
+
+logger = logging.getLogger(__name__)
+
+role_conversions = {"tool-response": "user", "tool-call": "assistant"}
+_raw_trace_lock = threading.Lock()
+
+
+class OpenAICompatModelConfig(BaseModel):
+    model_name: str
+    endpoint: str
+    api_key: str
+    timeout: float = 600.0
+
+
+class OpenAICompatEngine(LLMEngine):
+    """Minimal OpenAI-compatible chat-completions engine for ARE."""
+
+    def __init__(self, model_config: OpenAICompatModelConfig):
+        super().__init__(model_config.model_name)
+        self.model_config = model_config
+
+    def _convert_message(self, message: dict[str, Any]) -> dict[str, Any]:
+        role = MessageRole(message["role"]).value
+        role = role_conversions.get(role, role)
+
+        attachments: list[Attachment] | None = message.get("attachments")
+        content = message.get("content", "")
+        if not attachments:
+            return {"role": role, "content": content}
+
+        content_list: list[dict[str, Any]] = []
+        if content:
+            content_list.append({"type": "text", "text": content})
+        for attachment in attachments:
+            if attachment.mime.startswith("image/"):
+                content_list.append(attachment.to_openai_json())
+            else:
+                logger.warning("Unsupported attachment mime type: %s", attachment.mime)
+        return {"role": role, "content": content_list}
+
+    def chat_completion(
+        self,
+        messages: list[dict[str, Any]],
+        stop_sequences=[],
+        **kwargs,
+    ) -> tuple[str, dict | None]:
+        converted_messages = [self._convert_message(message) for message in messages]
+        url = self.model_config.endpoint.rstrip("/") + "/chat/completions"
+        payload: dict[str, Any] = {
+            "model": self.model_config.model_name,
+            "messages": converted_messages,
+        }
+        if stop_sequences:
+            payload["stop"] = stop_sequences
+
+        headers = {
+            "Authorization": f"Bearer {self.model_config.api_key}",
+            "Content-Type": "application/json",
+        }
+
+        try:
+            started_at = time.time()
+            response = requests.post(
+                url,
+                headers=headers,
+                json=payload,
+                timeout=self.model_config.timeout,
+            )
+        except requests.RequestException as e:
+            raise LLMEngineException(f"OpenAI-compatible request failed: {e}") from e
+
+        raw_text = response.text
+        _write_raw_trace(
+            model=self.model_config.model_name,
+            url=url,
+            payload=payload,
+            response=response,
+            raw_text=raw_text,
+            elapsed_seconds=time.time() - started_at,
+        )
+        if response.status_code >= 400:
+            logger.warning(
+                "OpenAI-compatible API error status=%s body=%s",
+                response.status_code,
+                raw_text[:4000],
+            )
+            raise LLMEngineException(
+                f"OpenAI-compatible API error status={response.status_code}: {raw_text[:1000]}"
+            )
+
+        try:
+            data = response.json()
+        except ValueError as e:
+            logger.warning("OpenAI-compatible API returned non-JSON body=%s", raw_text[:4000])
+            raise LLMEngineException(
+                f"OpenAI-compatible API returned non-JSON body: {raw_text[:1000]}"
+            ) from e
+
+        if data.get("error"):
+            logger.warning("OpenAI-compatible API returned error body=%s", raw_text[:4000])
+            raise LLMEngineException(
+                f"OpenAI-compatible API returned error: {str(data.get('error'))[:1000]}"
+            )
+
+        try:
+            content = data["choices"][0]["message"]["content"]
+        except (KeyError, IndexError, TypeError) as e:
+            logger.warning("OpenAI-compatible API unexpected body=%s", raw_text[:4000])
+            raise LLMEngineException(
+                f"OpenAI-compatible API unexpected body: {raw_text[:1000]}"
+            ) from e
+
+        if content is None:
+            raise LLMEngineException("OpenAI-compatible API returned empty content")
+
+        text = str(content).replace("False", "false").replace("True", "true")
+        for stop_token in stop_sequences:
+            text = text.split(stop_token)[0]
+
+        usage = data.get("usage") if isinstance(data, dict) else None
+        metadata = {"usage": usage} if usage is not None else None
+        return text, metadata
+
+    def simple_call(self, prompt: str) -> str:
+        text, _ = self.chat_completion([{"role": "user", "content": prompt}])
+        return text
+
+
+def _write_raw_trace(
+    *,
+    model: str,
+    url: str,
+    payload: dict[str, Any],
+    response: requests.Response,
+    raw_text: str,
+    elapsed_seconds: float,
+) -> None:
+    trace_dir = os.environ.get("ARE_RAW_LLM_TRACE_DIR")
+    if not trace_dir:
+        return
+
+    try:
+        messages = payload.get("messages") or []
+        message_summaries = []
+        for message in messages:
+            content = message.get("content", "")
+            if isinstance(content, str):
+                content_text = content
+                content_shape = "text"
+            else:
+                content_text = json.dumps(content, ensure_ascii=False, default=str)
+                content_shape = type(content).__name__
+            message_summaries.append(
+                {
+                    "role": message.get("role"),
+                    "content_shape": content_shape,
+                    "content_chars": len(content_text),
+                    "content_sha256": hashlib.sha256(content_text.encode("utf-8")).hexdigest(),
+                    "content_preview": content_text[:500],
+                }
+            )
+
+        record = {
+            "timestamp": time.time(),
+            "model": model,
+            "url": url,
+            "elapsed_seconds": elapsed_seconds,
+            "status_code": response.status_code,
+            "request": {
+                "model": payload.get("model"),
+                "message_count": len(messages),
+                "messages": message_summaries,
+                "stop": payload.get("stop"),
+            },
+            "response": {
+                "headers": {
+                    key: value
+                    for key, value in response.headers.items()
+                    if key.lower() not in {"authorization", "cookie", "set-cookie"}
+                },
+                "body_text": raw_text,
+            },
+        }
+
+        path = Path(trace_dir)
+        path.mkdir(parents=True, exist_ok=True)
+        with _raw_trace_lock:
+            with (path / "openai_compat_raw.jsonl").open("a", encoding="utf-8") as f:
+                f.write(json.dumps(record, ensure_ascii=False) + "\n")
+    except Exception:
+        logger.exception("Failed to write OpenAI-compatible raw trace")
